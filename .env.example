# PostgreSQL connection string (local docker-compose default shown).
DATABASE_URL="postgresql://autocompare:autocompare@localhost:5432/autocompare?schema=public"

# Public base URL used for metadata / share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Max DB connections per server instance (set to 1 when using `prisma dev`).
DATABASE_POOL_MAX=10

# Only with `prisma dev`: its shadow database (default port 51215), needed by `prisma migrate dev`.
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
